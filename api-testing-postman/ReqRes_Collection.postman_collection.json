    {
      "name": "03_Data_Validation",
      "item": [
        {
          "name": "GET List Users (Pagination & Structure)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Pagination details are correct\", () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.page).to.eql(1);",
                  "    pm.expect(json.per_page).to.eql(6);",
                  "    pm.expect(json.data).to.be.an(\"array\").with.lengthOf(6);",
                  "});",
                  "",
                  "pm.test(\"Every user item has valid fields\", () => {",
                  "    const json = pm.response.json();",
                  "    json.data.forEach(user => {",
                  "        pm.expect(user).to.have.all.keys(\"id\", \"email\", \"first_name\", \"last_name\", \"avatar\");",
                  "        pm.expect(user.id).to.be.a(\"number\");",
                  "        pm.expect(user.email).to.be.a(\"string\");",
                  "    });",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/users?page=1&per_page=6",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "per_page",
                  "value": "6"
                }
              ]
            }
          },
          "response": []
        }
      ]
    }
