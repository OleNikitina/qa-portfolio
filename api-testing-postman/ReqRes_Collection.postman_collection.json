  "item": [
    {
      "name": "01_Authentication",
      "item": [
        {
          "name": "POST Register - Success",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response contains id and token\", () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"id\");",
                  "    pm.expect(json).to.have.property(\"token\");",
                  "    pm.expect(json.token).to.be.a(\"string\").and.not.empty;",
                  "",
                  "    // Зберігаємо токен для наступних запитів",
                  "    pm.environment.set(\"token\", json.token);",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "x-api-key",
                  "type": "string"
                },
                {
                  "key": "value",
                  "value": "{{auth_secret_15s2}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"eve.holt@reqres.in\",\n  \"password\": \"pistol\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "register"
              ]
            }
          },
          "response": []
        },
        {
          "name": "POST Register - Missing Password (Negative)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400 Bad Request\", () => {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test(\"Error message is 'Missing password'\", () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.error).to.eql(\"Missing password\");",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "x-api-key",
                  "type": "string"
                },
                {
                  "key": "value",
                  "value": "{{auth_secret_15s2}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sydney@fife\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "register"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "02_Users_CRUD",
      "item": [
        {
          "name": "POST Create User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", () => {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"User created with correct details\", () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.name).to.eql(pm.environment.get(\"user_name\"));",
                  "    pm.expect(json.job).to.eql(pm.environment.get(\"user_job\"));",
                  "    pm.expect(json).to.have.property(\"id\");",
                  "    pm.expect(json).to.have.property(\"createdAt\");",
                  "",
                  "    // Зберігаємо згенерований ID",
                  "    pm.environment.set(\"user_id\", json.id);",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{user_name}}\",\n  \"job\": \"{{user_job}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/users",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users"
              ]
            }
          },
          "response": []
        },
        {
          "name": "GET Single User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Validate User Schema fields\", () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"data\");",
                  "    pm.expect(json.data.id).to.eql(2);",
                  "    pm.expect(json.data.email).to.match(/@reqres\\.in$/);",
                  "    pm.expect(json.data.avatar).to.include(\"https://\");",
                  "});"
                ],
                "type": "text/javascript",
